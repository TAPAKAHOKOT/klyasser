{
  "name": "klyasser-cloudflare",
  "private": true,
  "type": "module",
  "description": "Кляссер на Cloudflare Workers + D1 (+ R2)",
  "scripts": {
    "dev": "wrangler dev",
    "dev:d1": "wrangler dev --var STORAGE:d1",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote"
  },
  "devDependencies": {
    "wrangler": "4.152.0"
  }
}
